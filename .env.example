ANTHROPIC_API_KEY=
# Verificare i nomi dei modelli disponibili su docs.claude.com prima dell'uso
MODELLO_SIMULAZIONE=claude-sonnet-5-5
MODELLO_SINTESI=claude-opus-5-5
MODELLO_CLASSIFICAZIONE=claude-haiku-5-5
TETTO_SPESA_MENSILE_EUR=300
SOGLIA_CONFERMA_RUN_EUR=5
# Euro per 1 dollaro USA, per convertire i prezzi API. Valore indicativo:
# aggiornare con il cambio di riferimento BCE corrente.
CAMBIO_USD_EUR=0.86
# Tentativi automatici dell'SDK su errori temporanei (429, 5xx, rete), con backoff esponenziale
LLM_MAX_RETRIES=4

DB_PATH=data/campagna.duckdb
# Sfondo della mappa: osm (tile OpenStreetMap, richieste a server esterno) oppure nessuna
MAPPA_SFONDO=osm

# Connettori social (spenti finché non si attivano in config/fonti.yaml)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Raccolta automatica giornaliera di news e social dentro l'app (APScheduler)
RACCOLTA_AUTOMATICA=false

SECRET_KEY=
