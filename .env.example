ANTHROPIC_API_KEY=
# Verificare i nomi dei modelli disponibili su docs.claude.com prima dell'uso
MODELLO_SIMULAZIONE=claude-sonnet-5-5
MODELLO_SINTESI=claude-opus-5-5
MODELLO_CLASSIFICAZIONE=claude-haiku-5-5
TETTO_SPESA_MENSILE_EUR=300
SOGLIA_CONFERMA_RUN_EUR=5
